# CoogCrave environment variables.
# Copy to `.env` for local development:  cp .env.example .env
# Values below are LOCAL DEVELOPMENT placeholders that match scripts/sql/bootstrap-roles.sql.
# Never commit real secrets. Hosted environments set these in the platform's secret store.

# development | test | preview | production
APP_ENV=development

# Public origin of the app. Used for CSRF origin checks. Must be https in preview/production.
APP_URL=http://localhost:3000

# Runtime database connection: the least-privilege app role (DML only).
DATABASE_URL=postgresql://coogcrave_app:local_app_pw@localhost:5432/coogcrave_dev

# Migrations only: the role that owns the schema (DDL). Not used by the running app.
MIGRATOR_DATABASE_URL=postgresql://coogcrave_migrator:local_migrator_pw@localhost:5432/coogcrave_dev

# Integration tests (separate database; wiped between tests).
TEST_DATABASE_URL=postgresql://coogcrave_app:local_app_pw@localhost:5432/coogcrave_test
TEST_MIGRATOR_DATABASE_URL=postgresql://coogcrave_migrator:local_migrator_pw@localhost:5432/coogcrave_test

# Signs session cookies and email-verification links; at least 32 characters.
# This placeholder works locally and is refused in preview/production. Generate a real one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=local-dev-only-auth-secret-not-for-deployment-000

# Sign-up is limited to these email domains (comma-separated; subdomains match, so uh.edu
# covers cougarnet.uh.edu). A verified email proves inbox access, not current enrollment.
ALLOWED_EMAIL_DOMAINS=uh.edu

# Email. "file" writes each message to MAIL_OUTBOX_DIR as JSON instead of sending it; open the
# newest file there to find verification and reset links. Deployed environments need a real provider.
MAIL_TRANSPORT=file
MAIL_FROM=CoogCrave <no-reply@coogcrave.test>
MAIL_OUTBOX_DIR=.data/mail

# Password for the demo accounts created by `pnpm db:seed:demo` (refused when APP_ENV=production).
# Local placeholder; use a different value anywhere other people can reach the app.
SEED_DEMO_PASSWORD=maroon-lantern-bicycle-42

# Optional
DB_POOL_MAX=10
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Lets admins reset demo data from /admin (deletes demo accounts' orders, restores the sample catalog).
# Refused when APP_ENV=production.
DEMO_RESET_ENABLED=false

# Rehearsal helper: plays the restaurant automatically (confirm, then ready, 15 seconds apart).
# Leave off for a live demo, where an admin uses the Kitchen Console. Refused when APP_ENV=production.
DEMO_AUTO_ADVANCE=false
