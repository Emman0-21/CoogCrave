{
  "name": "coogcrave",
  "version": "0.1.0",
  "private": true,
  "description": "CoogCrave — student-powered campus food delivery for the University of Houston (independent hackathon project).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:drift": "node scripts/check-migration-drift.mjs",
    "db:local:up": "bash scripts/local-postgres.sh up",
    "db:local:down": "bash scripts/local-postgres.sh down",
    "check:tracked-env": "node scripts/check-tracked-env.mjs",
    "verify": "pnpm check:tracked-env && pnpm format:check && pnpm lint && pnpm typecheck && pnpm db:drift && pnpm test:coverage && pnpm build",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "dotenv": "18.0.7",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
